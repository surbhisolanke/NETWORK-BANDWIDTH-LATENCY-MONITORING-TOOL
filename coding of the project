DB_NAME = "latency_data.db"


def create_database():
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS latency_readings (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            timestamp TEXT,
            target TEXT,
            reading_no INTEGER,
            latency_ms REAL
        )
    """)

    conn.commit()
    conn.close()


def save_reading(target, reading_no, latency):
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()

    cursor.execute("""
        INSERT INTO latency_readings
        (timestamp, target, reading_no, latency_ms)
        VALUES (?, ?, ?, ?)
    """, (
        datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        target,
        reading_no,
        latency
    ))

    conn.commit()
    conn.close()


def save_bandwidth(measurement_type, speed_mbps):
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS bandwidth_readings (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            timestamp TEXT,
            measurement_type TEXT,
            speed_mbps REAL
        )
    """)

    cursor.execute("""
        INSERT INTO bandwidth_readings
        (timestamp, measurement_type, speed_mbps)
        VALUES (?, ?, ?)
    """, (
        datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        measurement_type,
        speed_mbps
    ))

    conn.commit()
    conn.close()


