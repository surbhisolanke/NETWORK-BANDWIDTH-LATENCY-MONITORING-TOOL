# ==========================================================
# BANDWIDTH MEASUREMENT
# ==========================================================

def measure_bandwidth():
    tester = speedtest.Speedtest()
    tester.get_best_server()

    download_mbps = tester.download() / 1_000_000
    upload_mbps = tester.upload() / 1_000_000

    return download_mbps, upload_mbps


